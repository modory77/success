# 이 파일을 .env 로 복사하고 값을 채우세요. (웹 UI의 "설정(API 키)"에서도 저장할 수 있습니다)

# 설명 화면 기획(Claude). 없으면 설명 화면 단계를 건너뜁니다.
ANTHROPIC_API_KEY=

# 일러스트 생성(OpenAI gpt-image-1). 없으면 Claude가 SVG 벡터로 직접 그립니다.
OPENAI_API_KEY=

# ── 선택 설정 (기본값 표시) ─────────────────────────────
# WHISPER_MODEL=large-v3        # 느리면 medium / small
# WHISPER_DEVICE=auto           # auto | cpu
# LANGUAGE=ko

# SILENCE_DB=-35                # 무음 판정 기준(dB). 배경소음이 크면 자동 보정
# MIN_SILENCE=0.6               # 이 길이(초) 이상 무음만 편집
# KEEP_SILENCE=0.3              # 긴 무음을 이 길이로 줄임
# REMOVE_STUTTERS=true          # "그 그 그" 같은 반복 제거

# ILLUSTRATIONS=true
# ILLUSTRATION_MODE=cutaway     # cutaway(전체 화면 전환) | center(중앙 카드) | pip(우측 카드)
# MAX_SCENES_PER_MIN=1.5
# CLAUDE_MODEL=claude-sonnet-5-5
# IMAGE_PROVIDER=auto           # auto | openai | svg
# IMAGE_MODEL=gpt-image-1
# IMAGE_QUALITY=medium          # low | medium | high
# OVERLAYS=true                 # 회사/제품 언급 시 로고 띄우기
# OVERLAYS_PER_MIN=4.0
# LOGO_DIR=./로고               # 로고 이미지(png/jpg/webp/svg) 폴더. 파일 이름이 곧 브랜드 이름

# MOSAIC=true
# OCR_INTERVAL=0.5              # 초 단위 화면 검사 간격(짧을수록 정확, 느림)
# BLUR_FACES=false              # 얼굴 모자이크(본인 얼굴도 가려지므로 기본 OFF)
# BLUR_WORDS=                   # 추가로 가릴 단어(쉼표 구분)
# MUTE_SPOKEN_PII=false         # 말로 나온 개인정보 음소거

# SUBTITLES=true
# VIDEO_CODEC=auto              # auto | h264_nvenc | libx264
# VIDEO_QUALITY=19              # 낮을수록 고화질(파일 커짐)
# OUT_DIR=./output
# WORK_DIR=./work
